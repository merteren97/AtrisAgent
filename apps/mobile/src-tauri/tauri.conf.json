{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtrisAgent Mobile",
  "version": "0.1.0",
  "identifier": "com.atrishub.agent.mobile",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:4175", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "AtrisAgent", "width": 390, "height": 844 }], "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://atrishub.com wss://agent.atrishub.com" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
