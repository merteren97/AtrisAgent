# AtrisHub is the authoritative login, session and Premium entitlement service.
# Keep this URL on the server side; the desktop app talks to the local gateway.
ATRIS_AUTH_API_URL=https://atrishub.com

# Short server-side cache for a previously verified Hub session.
ATRIS_AUTH_CACHE_MS=30000

# Bounded GET/HEAD stale window when AtrisHub is temporarily unreachable.
# Mutations remain fail-closed when the Hub cannot be reached.
ATRIS_AUTH_STALE_CACHE_MS=60000

# Packaged sidecar protocol (leave blank for ordinary local development).
# The token is accepted only in X-Atris-Runtime-Token, never in a URL.
ATRIS_RUNTIME_TOKEN=
# Packaged version echoed in health and the machine-readable ready line.
ATRIS_AGENT_VERSION=
ATRIS_PARENT_PID=
# Absolute path to the bundle-relative MCP bridge resource when packaging.
ATRIS_CONTROL_PLANE_BRIDGE_PATH=

# Shared per-user runtime/database root. Existing legacy APPDATA DBs are read
# in place when this is unset; no automatic migration or deletion is performed.
ATRIS_AGENT_DATA_DIR=
