# Desktop frontend API route
VITE_ATRIS_API_URL=http://127.0.0.1:3001/api

# Local API Gateway
PORT=3001
NODE_ENV=development

# Optional custom AtrisAgent data directory
# Windows example: %LOCALAPPDATA%\AtrisAgent
ATRIS_AGENT_DATA_DIR=

# Public landing/release service defaults. Production process configuration is maintained outside this repository.
# HOST=127.0.0.1
# PORT=3003
# NODE_ENV=production
AGENT_PUBLIC_BASE_URL=https://agent.atrishub.com
AGENT_RELEASE_REPO_OWNER=merteren97
AGENT_RELEASE_REPO_NAME=AtrisAgent
# Keep release credentials out of source control; set this only in the server environment.
AGENT_RELEASE_REPO_ACCESS_TOKEN=
